{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/technothatch/dump1090-grafana/schema/dashboard.schema.json",
  "title": "dump1090-grafana dashboard",
  "description": "The subset of the Grafana 10/11 dashboard model that dump1090-grafana ships and validates: stable uid, at least four panels, Prometheus datasource variable ${DS_PROMETHEUS} everywhere, and a unit plus thresholds in every panel's fieldConfig.defaults.",
  "type": "object",
  "required": ["uid", "title", "schemaVersion", "panels", "templating", "time"],
  "properties": {
    "uid": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 40
    },
    "title": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "minimum": 38 },
    "id": { "type": ["integer", "null"] },
    "description": { "type": "string" },
    "editable": { "type": "boolean" },
    "graphTooltip": { "type": "integer", "minimum": 0, "maximum": 2 },
    "refresh": { "type": ["string", "boolean"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "panels": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/panel" }
    },
    "templating": { "$ref": "#/$defs/templating" },
    "time": { "$ref": "#/$defs/timeRange" },
    "__inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    }
  },
  "$defs": {
    "prometheusRef": {
      "type": "object",
      "description": "Every Prometheus datasource reference in a dashboard, panel or target.",
      "required": ["type", "uid"],
      "properties": {
        "type": { "const": "prometheus" },
        "uid": { "const": "${DS_PROMETHEUS}" }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["mode", "steps"],
      "properties": {
        "mode": { "enum": ["absolute", "absolute-from"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["color"],
            "properties": {
              "color": { "type": "string", "minLength": 1 },
              "value": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fieldConfig": {
      "type": "object",
      "required": ["defaults", "overrides"],
      "properties": {
        "defaults": {
          "type": "object",
          "required": ["unit", "thresholds"],
          "properties": {
            "unit": { "type": "string", "minLength": 1 },
            "thresholds": { "$ref": "#/$defs/thresholds" },
            "mappings": { "type": "array" },
            "color": { "type": "object" },
            "custom": { "type": "object" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "overrides": { "type": "array" }
      },
      "additionalProperties": false
    },
    "gridPos": {
      "type": "object",
      "required": ["h", "w", "x", "y"],
      "properties": {
        "h": { "type": "integer", "minimum": 1 },
        "w": { "type": "integer", "minimum": 1, "maximum": 24 },
        "x": { "type": "integer", "minimum": 0, "maximum": 23 },
        "y": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["expr", "refId", "datasource"],
      "properties": {
        "datasource": { "$ref": "#/$defs/prometheusRef" },
        "editorMode": { "type": "string" },
        "expr": { "type": "string", "minLength": 1 },
        "legendFormat": { "type": "string" },
        "range": { "type": "boolean" },
        "refId": { "type": "string", "minLength": 1 }
      }
    },
    "panel": {
      "type": "object",
      "required": ["id", "type", "title", "datasource", "gridPos", "fieldConfig", "targets"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "type": {
          "enum": ["timeseries", "stat", "barchart", "gauge", "table", "piechart", "bargauge"]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "datasource": { "$ref": "#/$defs/prometheusRef" },
        "gridPos": { "$ref": "#/$defs/gridPos" },
        "fieldConfig": { "$ref": "#/$defs/fieldConfig" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        },
        "options": { "type": "object" },
        "transparent": { "type": "boolean" }
      }
    },
    "templating": {
      "type": "object",
      "required": ["list"],
      "properties": {
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "query"],
            "properties": {
              "name": { "const": "DS_PROMETHEUS" },
              "type": { "const": "datasource" },
              "query": { "type": "string" },
              "label": { "type": "string" },
              "current": { "type": "object" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "timeRange": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["name", "label", "type", "pluginId", "pluginName"],
      "properties": {
        "name": { "const": "DS_PROMETHEUS" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "const": "datasource" },
        "pluginId": { "const": "prometheus" },
        "pluginName": { "const": "Prometheus" }
      },
      "additionalProperties": false
    }
  }
}
